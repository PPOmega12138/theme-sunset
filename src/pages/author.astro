---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
---

<Layout>
  <Fragment slot="head">
    <title th:text="|${author.spec.displayName} - ${site.title}|"></title>
  </Fragment>

  <div class="card page-heading">
    <h1 th:text="|${author.spec.displayName}的文章|"></h1>
    <p class="page-meta">
      <span th:text="|${posts.total} 篇文章|"></span>
    </p>
  </div>


  <PostList />


  <nav
    th:if="${posts.totalPages gt 1}"
    class="pagination"
    aria-label="Pagination"
  >
    <a
      th:if="${posts.hasPrevious()}"
      th:href="@{${posts.prevUrl}}"
      class="pagination__prev">&larr; 上一页</a
    >
    <span
      class="card pagination__info"
      th:text="|${posts.page} / ${posts.totalPages}|"></span>
    <a
      th:if="${posts.hasNext()}"
      th:href="@{${posts.nextUrl}}"
      class="pagination__next">下一页 &rarr;</a
    >
  </nav>
</Layout>


<style>
  .page-heading h1{
    text-transform: none;
  }
</style>