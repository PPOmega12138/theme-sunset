---
import Layout from "../layouts/Layout.astro";
import "../styles/moments.css"
---

<Layout pageTitle="动态" pageSubtitle="moments">
  <Fragment slot="head">
    <title th:text="|动态 - ${site.title}|"></title>
  </Fragment>

  <Fragment slot="background">
    <div
      class="site-background"
      aria-hidden="true"
      th:if="${not #strings.isEmpty(theme.config.background.moments_bgimg)}"
      th:style="'background-image: url('+ ${theme.config.background.moments_bgimg}+');'"
    >
    </div>
  </Fragment>

  <div>
    <ul class="moments-list">
      <li
        th:each="moment : ${moments.items}"
        th:with="content=${moment.spec.content}"
        class="moments-card"
      >
        <div
          th:text="${#temporals.format(moment.spec.releaseTime, 'yyyy-MM-dd')}"
          class="moments-card__time"
        >
        </div>

        <div
          th:if="${not #strings.isEmpty(content.html)}"
          th:utext="${content.html}"
          class="moments-card__content"
        >
        </div>

        <div
          th:if="${not #lists.isEmpty(content.medium)}"
          class="moments-card__media"
        >
          <th:block th:each="momentItem : ${content.medium}">
          <button
            type="button"
            th:if="${momentItem.type.name == 'PHOTO'}"
            class="moments-card__img"
          >
            <img
              th:src="${momentItem.url}"
            />
          </button>
          <video
            th:if="${momentItem.type.name == 'VIDEO'}"
            th:src="${momentItem.url}"
            controls="true"
            class="moments-card__video"
          ></video>
          <audio
            th:if="${momentItem.type.name == 'AUDIO'}"
            th:src="${momentItem.url}"
            controls="true"
            class="moments-card__audio"  
          ></audio>
            </th:block>
        </div>
      </li>
    </ul>


    <div th:if="${moments.hasPrevious() || moments.hasNext()}" class="pagination">
      <a 
        th:href="@{${moments.prevUrl}}" 
        class="pagination__prev"
        th:if="${moments.hasPrevious()}"
      >
        <span>&larr; 上一页</span>
      </a>
      <span
        class="pagination__info"
        th:text="|第 ${moments.page} 页  共 ${moments.totalPages} 页|"
      ></span>
      <a 
        th:href="@{${moments.nextUrl}}" 
        class="pagination__next"
        th:if="${moments.hasNext()}"
      >
        <span>下一页 &rarr;</span>
      </a>
    </div>

  </div>
</Layout>
