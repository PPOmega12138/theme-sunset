---
import Layout from "../layouts/Layout.astro";
import "../styles/photos.css"
---

<Layout pageTitle="图库" pageSubtitle="PHOTOS">
  <Fragment slot="head">
    <title th:text="|图库 - ${site.title}|"></title>
  </Fragment>

  <Fragment slot="background">
    <div
      class="site-background"
      aria-hidden="true"
      th:if="${not #strings.isEmpty(theme.config.background.photos_bgimg)}"
      th:style="'background-image: url('+ ${theme.config.background.photos_bgimg}+');'"
    >
    </div>
  </Fragment>

  <div
    class="photos-groups"
  >
    <a
      class="card photos-groups__item"
      th:href="@{${photoUrl.list()}}"
      data-photo-group=""
    > 全部图片</a>
    <a
      class="card photos-groups__item"
      th:each="groupItem : ${groups}"
      th:href="@{${photoUrl.list(groupItem.metadata.name)}}"
      th:text="${groupItem.spec.displayName}"
      th:attr="data-photo-group=${groupItem.metadata.name}"
    ></a>
  </div>

  <div
    class="photos-list"
    th:if="${photos.items}"
  >
    <div
      class="photos-list__item"
      th:each="photo: ${photos.items}"
    >
      <a
        class="glightbox photos-item__link"
        th:href="${photo.spec.url}"
      >
        <img
          class="photos-item__img"
          th:src="${photo.spec.cover ?: photo.spec.url}"
        />
      </a>
    </div>
  </div>

  <div
    class="card photos-empty"
    th:if="${#lists.isEmpty(photos.items)}"
  >
    暂无图片
  </div>

  <nav
  class="pagination"
  aria-label="图库分页"
  th:if="${photos.hasPrevious() || photos.hasNext()}"
>
  <a
    class="pagination__prev"
    th:if="${photos.hasPrevious()}"
    th:href="@{${photos.prevUrl}}"
  >
    &larr; 上一页
  </a>

  <span
    class="card pagination__info"
    th:text="|第 ${photos.page} 页，共 ${photos.totalPages} 页|"
  >
  </span>

  <a
    class="pagination__next"
    th:if="${photos.hasNext()}"
    th:href="@{${photos.nextUrl}}"
  >
    下一页 &rarr;
  </a>
</nav>


</Layout>


<script>
import { initImagePreview } from "../features/mediaPreview";
initImagePreview(".photos-list");


const currentGroup = new URLSearchParams(window.location.search).get("group") ?? "";

document.querySelectorAll<HTMLElement>(".photos-groups__item").forEach((item) => {
  const isActive = item.dataset.photoGroup === currentGroup

  item.classList.toggle("is-active",isActive);
});
</script>