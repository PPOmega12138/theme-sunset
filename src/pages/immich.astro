---
import Layout from "../layouts/Layout.astro";
import "../styles/photos.css";
import "../styles/immich.css";
import "../styles/highlightjs.css"
---

<Layout pageTitleExpression="${singlePage.spec.title}" pageSubtitle="photos">
  <Fragment slot="head">
    <title th:text="|${singlePage.spec.title} - ${site.title}|"></title>
  </Fragment>
  <Fragment slot="background">
    <div
      class="site-background"
      aria-hidden="true"
      th:if="${not #strings.isEmpty(theme.config.background.photos_bgimg)}"
      th:style="'background-image: url('+ ${theme.config.background.photos_bgimg}+');'"
    >
    </div>
  </Fragment>

  <div
    th:utext="${singlePage.content.content}"
    class="js-content card content"
    th:if="${not #strings.isEmpty(singlePage.content.content)}"
  >
  </div>

  <div class="card immich-album__name">
    <a
      class="immich-album__link"
      th:href="${theme.config.photos.immich_url}"
      target="_blank"
    >
      Loading...
    </a>
  </div>

  <div class="card immich-loading">Images Loading...</div>

  <div
    class="photos-list"
    th:style="|--photos-columns: ${theme.config.photos.columns};|"
    th:attr="data-shared-url=${theme.config.photos.immich_url}, data-page-size=${theme.config.photos.immich_page_size}"
  >
  </div>

  <div
    class="card immich-loadmore"
    hidden
  >加载更多</div>
</Layout>

<script>
  import type { ImmichAlbum } from "../features/immichPhotos";
  import { getImmichGallery, type ImmichAsset } from "../features/immichPhotos";
  import { initImagePreview } from "../features/mediaPreview";
  import { initHighlight } from "../features/highlightjs";

  initHighlight(".js-content pre > code")

  function addAlbumName(container: HTMLElement, album: ImmichAlbum) {
    container.textContent = album.name;
  }

  function renderAssets(container: HTMLElement, assets: ImmichAsset[]) {
    const fragment = document.createDocumentFragment();
    const batch = document.createElement("div");
    batch.className = "immich-list__batch"

    for (const asset of assets) {
      if (!asset.isImage) continue;

      const item = document.createElement("div");
      item.className = "photos-list__item";

      const link = document.createElement("a");
      link.className = "glightbox photos-item__link";
      link.href = asset.previewUrl;
      link.dataset.type = "image";
      link.dataset.downloadUrl = asset.originalUrl;

      const img = document.createElement("img");
      img.className = "photos-item__img";
      img.loading = "lazy";
      img.decoding = "async";
      img.style.opacity = "0";
      img.addEventListener(
        "load",
        () => {
          img.style.opacity = "1";
          loading?.remove();
        },
        { once: true },
      );
      img.src = asset.thumbnailUrl;

      link.append(img);
      item.append(link);
      fragment.append(item);
    }

    batch.append(fragment)
    container.append(batch);
  }

  async function loadNextPage() {
    if (isLoading) return;

    isLoading = true;

    if(loadmore) loadmore.hidden = true;

    while(
      assetBuffer.length < pageSize &&
      nextBucketIndex < buckets.length
    ){
      const bucket = buckets[nextBucketIndex];
      nextBucketIndex += 1;

      const assets = await gallery.getBucketAssets(
        album.id, bucket.timeBucket
      );

      assetBuffer.push(
        ...assets.filter((asset) => asset.isImage)
      )
    }

    const assets = assetBuffer.splice(0,pageSize);

    if(assets.length > 0){
      renderAssets(container,assets);
      lightbox?.reload();
    }

    const hasMore = assetBuffer.length > 0 || nextBucketIndex < buckets.length;

    if(loadmore) loadmore.hidden = !hasMore;

    if(!hasMore && container?.children.length === 0) loading?.remove;

    isLoading = false;
  }



  const container = document.querySelector<HTMLElement>("[data-shared-url]");
  const sharedUrl = container?.dataset.sharedUrl;
  const albumLink = document.querySelector<HTMLElement>(".immich-album__link");
  const loading = document.querySelector<HTMLElement>(".immich-loading");
  const loadmore = document.querySelector<HTMLElement>(".immich-loadmore")

  if (!container || !sharedUrl) throw new Error("未配置 Immich 共享图库");

  const parsedPageSize = Number.parseInt(container.dataset.pageSize ?? '',10,);
  const pageSize = Number.isNaN(parsedPageSize) ? 30 : parsedPageSize;

  let nextBucketIndex = 0;
  let assetBuffer: ImmichAsset[] = [];
  let isLoading = false;

  const gallery = getImmichGallery(sharedUrl);

  const album = await gallery.getSharedAlbum();
  if (albumLink) addAlbumName(albumLink, album);

  const buckets = await gallery.getTimeBuckets(album.id);
  const lightbox = initImagePreview(".photos-list");

  await loadNextPage();

  const content = document.querySelector<HTMLElement>(".content");

  if (
    content &&
    !content.textContent?.trim() &&
    !content.querySelector("img, video, audio, iframe")
  ) {
    content.remove();
  }

  loadmore?.addEventListener("click", () => {
    loadNextPage();
  })



</script>
