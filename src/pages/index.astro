---
import Layout from "../layouts/Layout.astro";
import "../styles/index.css"
---

<Layout contentClass="homepage">
  <Fragment slot="head">
    <title th:text="${site.title}"></title>
  </Fragment>
  <Fragment slot="background">
    <div
      class="site-background"
      aria-hidden="true"
      th:if="${not #strings.isEmpty(theme.config.index.background_image)}"
      th:style="'background-image: url('+ ${theme.config.index.background_image}+');'"
    ></div>
  </Fragment>


  <section class="index-board" aria-label="homepage">
    <section class="index-card index-card--welcome">

      <div class="index-welcome--content">
        <p
          class="index-welcome--content index-welcome--content-1"
          th:text="${#strings.isEmpty(theme.config.index.welcome_content_1) ? '写点东西' : theme.config.index.welcome_content_1}"
        >
        写点东西
        </p>
        <p
          class="index-welcome--content index-welcome--content-2"
          th:text="${#strings.isEmpty(theme.config.index.welcome_content_2) ? '留给未来的自己' : theme.config.index.welcome_content_2} "
        >
          留给未来的自己
        </p>
        <p class="index-card--sitename">
          WELCOME TO 
          <span 
            th:text="${site.title}"
            class="index-card--sitetitle"
          >Sunset</span>
        </p>

      </div>
      <div
        class="index-welcome--image"
        th:if="${not #strings.isEmpty(theme.config.index.welcome_image)}"
      >
        <img
          th:src="${theme.config.index.welcome_image}"
          alt=""
          loading="eager"
        />
      </div>
    </section> 
    
    <section 
      class="index-card index-card--motto"
      
    >
      <div class="index-motto--dates">

        <svg
          class="index-motto--calendar"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <path d="M16 2v4"></path>
        <path d="M8 2v4"></path>
        <path d="M3 10h18"></path>
        </svg>

        <time class="index-motto--date" id="current-date"></time>
        <span class="index-motto--weekday" id="current-weekday"></span>
      </div>


      <div
        class="index-motto--content"
        th:if="${not #strings.isEmpty(theme.config.index.motto)}"
      >
        <p
          th:text="${theme.config.index.motto}"
        >a motto here</p>
      </div>

    </section>

    <section class="index-card index-card--recent" aria-labelledby="recent-notes-title">
      <div class="index-card--heading">
        <p class="index-card--eyebrow">RECENT NOTES</p>
        <h2 id="recent-notes-title">最近文章</h2>
      </div>

      <div
        class="index-recent--list"
        th:if="${not #lists.isEmpty(posts.items)}"
      >
        <div
          class="index-recent--item"
          th:each="post,postStat : ${posts.items}"
          th:if="${postStat.index lt 3}"
        >
          <a th:href="@{${post.status.permalink}}"             th:if="${not #strings.isEmpty(post.spec.cover)}">
            <img
            class="index-recent--image"
            th:src="${post.spec.cover}"
            alt=""
            loading="lazy"
            />
          </a>
          <div class="index-recent--info">
            <a
              th:if="${not #lists.isEmpty(post.categories)}"
              th:href="@{${post.categories[0].status.permalink}}"
            >
              <p
                class="index-recent--categories"
                th:text="${post.categories[0].spec.displayName}"
                >分类</p>
            </a>

            <a th:href="@{${post.status.permalink}}">
              <p
              class="index-recent--title"
              th:text="${post.spec.title}"
              >文章标题</p>
              <p
              class="index-recent--excerpt"
              th:text="${post.status.excerpt}"
              >摘要</p>
            </a>
          </div>
        </div>

        <a class="index-card  index-card--archives" th:href="@{${site.routes.archivesUri}}">
          <p class="index-card--eyebrow">ALL NOTES</p>
          <h2>全部文章</h2>
          <span>看看所有的文章&nbsp;→</span>
        </a>

      </div>

      <p
        class="index-card--empty"
        th:if="${#lists.isEmpty(posts.items)}"
      >
        还没有发布文章。
      </p>
    </section>

    <section class="index-card index-card--life">
      <div class="index-card--heading">
        <p class="index-card--eyebrow">RECENT LIFE</p>
        <h2 id="recent-notes-title">生活小记</h2>
      </div>

      <a
      class="index-card index-card--photos"
      th:href="@{/photos}"
      >
      <p
        class="index-card--eyebrow"
      >
        ALBUMS
      </p>
      <h2>相册</h2>
      </a>

      <a class="index-card index-card--moments" th:href="@{/moments}">
      <p class="index-card--eyebrow">MOMENTS</p>
      <h2>动态</h2>
      <span>最近发生了什么&nbsp; →</span>
      </a>

    </section>
  </section>
</Layout>

<script>
  const dateElement = document.querySelector("#current-date")
  const weekdayElement = document.querySelector("#current-weekday")

  if (dateElement && weekdayElement){
    const now = new Date()

    const dateText = new Intl.DateTimeFormat("zh-CN",{
      month:"long",
      day:"numeric",
    }).format(now);

    const weekdayText = new Intl.DateTimeFormat("zh-CN",{
      weekday:"long"
    }).format(now);

    dateElement.dateTime = [
      now.getFullYear(),
      String(now.getMonth()+1).padStart(2,"0"),
      String(now.getDate()).padStart(2,"0"),
    ].join("-");

    dateElement.textContent = dateText;
    weekdayElement.textContent = weekdayText;
  }
</script>