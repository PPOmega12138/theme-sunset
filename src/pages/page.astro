---
import Layout from "../layouts/Layout.astro";
import "../styles/highlightjs.css"
---

<Layout contentClass="prose" pageTitleExpression="${singlePage.spec.title}" pageSubtitleExpression="${singlePage.spec.slug}">
  <Fragment slot="head">
    <title th:text="|${singlePage.spec.title} - ${site.title}|"></title>
  </Fragment>

  <Fragment slot="background">
    <div
      class="site-background"
      aria-hidden="true"
      th:if="${not #strings.isEmpty(singlePage.spec.cover)}"
      th:style="'background-image: url('+ ${singlePage.spec.cover}+');'"
    ></div>
  </Fragment>

  <div 
    th:utext="${singlePage.content.content}"
    class="content js-content"></div>

  <div class="comment">
    <halo:comment
      group="content.halo.run"
      kind="SinglePage"
      th:attr="name=${singlePage.metadata.name}"></halo:comment>
  </div>
</Layout>


<script>
  import { initHighlight } from "../features/highlightjs";
  initHighlight(".js-content pre > code");
</script>