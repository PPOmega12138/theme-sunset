---
import ThemeSwitcher from "./ThemeSwitcher.vue";
import UserButton from "./UserButton.vue";
---

<header>
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-logo">
        <img
          th:if="${not #strings.isEmpty(site.logo)}"
          th:src="${site.logo}"
        />
      </span>
{/*     <span class="brand-titles">
        <strong class="brand-title" th:text="${site.title}">站点标题</strong>
        <small
          class="brand-subtitle"
          th:if="${not #strings.isEmpty(site.subtitle)}"
          th:text="${site.subtitle}"
        />
      </span>
*/}
    </a> 

    <nav
      th:with="menu = ${menuFinder.getPrimary()}"
      aria-label="Main navigation"
    >
      <ul class="menu-list">
        <li th:each="menuItem: ${menu.menuItems}" class="menu-item">
          <a
            class="menu-link"
            th:href="@{${menuItem.status.href}}"
            th:target="${menuItem.spec.target?.value}"
            th:text="${menuItem.status.displayName}"
          >
          </a>
        <ul
          class="submenu"
          th:if="${not #lists.isEmpty(menuItem.children)}"
        >
          <li th:each="child:${menuItem.children}">
            <a
            th:href="@{${child.status.href}}"
            th:target="${child.spec.target?.value}"
            th:text="${child.status.displayName}"
            >
            </a>
          </li>
        </ul>
        </li>
      </ul>
    </nav>
    <div class="header-actions">
      <ThemeSwitcher client:load />
      <UserButton client:load>
        <span
          slot="fallback" class="user-button-fallback" aria-hidden="true"
        ></span>
      </UserButton>
    </div>
  </div>
</header>

<style>
  header {
    background: color-mix(in srgb,var(--bg) 50%,transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
    align-items: center;
    gap: 2rem;
    width: 100%;
    padding-inline: 1.25rem;
    margin: 0 auto;
    height: 58px;
    margin: 0 auto;
  }

  .brand {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-self: start;
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand-logo{
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    flex-shrink: 0;
    background: transparent;
    color: var(--accent);
  }

  .brand-logo img{
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-titles{
    display: flex;
    flex-direction: column;
    gap: 0,1rem;
  }

  .brand-title,.brand-subtitle{
    margin: 0;
  }


  nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 0.2rem;
  }


  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.35rem;
    margin-left: 0;
  }

  .user-button-fallback {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--bg-raised) 0%,
      color-mix(in srgb, var(--bg-raised) 78%, var(--ink) 22%) 50%,
      var(--bg-raised) 100%
    );
    background-size: 200% 100%;
    animation: user-button-fallback-shimmer 1.2s ease-in-out infinite;
    pointer-events: none;
  }

  nav :global(.menu-list),nav :global(.submenu){
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav :global(.menu-list) {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  nav :global(.menu-item) {
    position: relative;
    padding-bottom: 0.5rem;
    margin-bottom: -0.5rem;
  }

  nav :global(.menu-link),
  nav :global(.submenu a) {
    display: block;
    color: var(--ink-2);
    text-decoration: none;
  } 

  nav :global(.menu-link) {
  padding: 0.3rem 0.65rem;
  border-radius: 6px;
  font-size: 0.9rem;
  transition: color 0.15s ease, background 0.15s ease;
  }
  
  nav :global(.menu-link:hover) {
  color: var(--ink);
  background: var(--bg-raised);
  }

  nav :global(.submenu) {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 110;
    display: grid;
    min-width: 9rem;
    padding: 0.4rem;
    border-radius: 0.9rem;
    background: var(--surface);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    transition:
      opacity 0.16s ease 0.2s,
      transform 0.16s ease 0.2s,
      visibility 0s linear 0.36s,
      pointer-events 0s linear 0.36s;
  }

  nav :global(.submenu a) {
    padding: 0.5rem 0.6rem;
    border-radius: 0.55rem;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  nav :global(.submenu a:hover),
  nav :global(.submenu a:focus-visible) {
    color: var(--ink);
    background: var(--bg-raised);
  }


  nav :global(.menu-item:hover > .submenu),
  nav :global(.menu-item:focus-within > .submenu) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  @media (max-width: 680px) {
    .header-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      height: auto;
      padding: 1rem 0;
      gap: 0.75rem;
    }

    nav {
      flex-wrap: wrap;
      gap: 0.1rem;
      margin-left: -0.65rem;
      flex: initial;
    }

    .header-actions {
      margin-left: 0;
    }
  }

  @keyframes user-button-fallback-shimmer {
    0% {
      background-position: 200% 0;
    }

    100% {
      background-position: -200% 0;
    }
  }
</style>
