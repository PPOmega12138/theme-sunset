---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import UserButton from "./UserButton.astro";
import MingcuteSearchLine from "~icons/mingcute/search-line";
import MenuLine from "~icons/mingcute/menu-line";
import CloseLine from "~icons/mingcute/close-line";
---

<header>
  <div class="header-inner">
    <a class="brand" href="/">
      <span class="brand-logo">
        <img th:if="${not #strings.isEmpty(site.logo)}" th:src="${site.logo}" />
      </span>
      {
        /*     <span class="brand-titles">
        <strong class="brand-title" th:text="${site.title}">站点标题</strong>
        <small
          class="brand-subtitle"
          th:if="${not #strings.isEmpty(site.subtitle)}"
          th:text="${site.subtitle}"
        />
      </span>
*/
      }
    </a>

    <nav
      th:with="menu = ${menuFinder.getPrimary()}"
      aria-label="Main navigation"
      class="header-nav"
      id="site-navigation"
    >
      <ul class="menu-list">
        <li th:each="menuItem: ${menu.menuItems}" class="menu-item">
          <a
            class="menu-link"
            th:href="@{${menuItem.status.href}}"
            th:target="${menuItem.spec.target?.value}"
            th:text="${menuItem.status.displayName}"
          >
          </a>
          <ul class="submenu" th:if="${not #lists.isEmpty(menuItem.children)}">
            <li th:each="child:${menuItem.children}">
              <a
                th:href="@{${child.status.href}}"
                th:target="${child.spec.target?.value}"
                th:text="${child.status.displayName}"
              >
              </a>
            </li>
          </ul>
        </li>
      </ul>
    </nav>
    <div class="header-actions">
      <a
        href="javascript:SearchWidget.open()"
        title="搜索"
        class="search-button"
        th:if="${pluginFinder.available('PluginSearchWidget')}"
      >
        <MingcuteSearchLine aria-hidden="true" />
      </a>

      <ThemeSwitcher />
      <UserButton />

      <button
        type="button"
        class="menu-toggle"
        aria-label="open menu"
        aria-controls="site-navigation"
        aria-expanded="false"
      >
        <MenuLine class="menu-open-icon" aria-hidden="true" />
        <CloseLine class="menu-close-icon" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style>
  header {
    background: color-mix(in srgb, var(--bg) 50%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    width: 100%;
    padding-inline: 1.25rem;
    margin: 0 auto;
    height: 58px;
    margin: 0 auto;
  }

  .brand {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-self: start;
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand-logo {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    flex-shrink: 0;
    background: transparent;
    color: var(--accent);
  }

  .brand-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-titles {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brand-title,
  .brand-subtitle {
    margin: 0;
  }

  nav {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 0.2rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.35rem;
    margin-left: 0;
  }

  .user-button-fallback {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--bg-raised) 0%,
      color-mix(in srgb, var(--bg-raised) 78%, var(--ink) 22%) 50%,
      var(--bg-raised) 100%
    );
    background-size: 200% 100%;
    animation: user-button-fallback-shimmer 1.2s ease-in-out infinite;
    pointer-events: none;
  }

  nav .menu-list,
  nav .submenu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav .menu-list {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  nav .menu-item {
    position: relative;
    padding-bottom: 0.5rem;
    margin-bottom: -0.5rem;
  }

  nav .menu-link,
  nav .submenu a {
    display: block;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav .menu-link {
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.9rem;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  nav .menu-link:hover {
    color: var(--ink);
    background: var(--bg-raised);
  }

  nav .submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 110;
    display: grid;
    min-width: 9rem;
    padding: 0.4rem;
    border-radius: 0.9rem;
    background: var(--surface);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    transition:
      opacity 0.16s ease 0.2s,
      transform 0.16s ease 0.2s,
      visibility 0s linear 0.36s,
      pointer-events 0s linear 0.36s;
  }

  nav .submenu a {
    padding: 0.5rem 0.6rem;
    border-radius: 0.55rem;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  nav .submenu a:hover,
  nav .submenu a:focus-visible {
    color: var(--ink);
    background: var(--bg-raised);
  }

  nav .menu-item:hover > .submenu,
  nav .menu-item:focus-within > .submenu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  .search-button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--ink-2);
    text-decoration: none;
    transition: all 180ms ease;
  }

  .search-button:hover,
  .search-button:focus-visible {
    color: var(--ink);
    background: var(--bg-raised);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 780px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      height: 58px;
      gap: 0.5rem;
    }

    nav {
      position: absolute;
      top: 100%;
      left: 20%;
      right: 0;
      display: block;

      visibility: hidden;
      pointer-events: none;
      opacity: 0;

      transition: all 180ms ease;
      transform: translateY(-0.5rem);

      justify-self: stretch;
      margin: 0;
      background: color-mix(in srgb, var(--surface) 95%, transparent);
      border-radius: 0.9rem;
      max-height: calc(100dvh - 58px - 0.5rem);
      overflow-y: auto;
    }

    nav .menu-link {
      width: 100%;
      text-align: left;
    }
    nav .menu-list {
      display: grid;
      width: 100%;
      justify-items: stretch;
      border-radius: 0.75rem;
    }

    nav .menu-item {
      padding-bottom: 0;
      margin-bottom: 0;
    }

    nav.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .header-actions {
      margin-left: 0;
    }

    nav .submenu,
    nav .menu-item:hover > .submenu,
    nav .menu-item:focus-within > .submenu {
      position: static;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;

      transition: none;
      transform: none;

      background: none;
      box-shadow: none;

      margin-left: 0.5rem;
    }

    .menu-toggle {
      display: grid;
      place-items: center;
      background: transparent;
      border: none;
      border-radius: 50%;
      height: 34px;
      width: 34px;
      padding: 0;
      border: 0;
      line-height: 0;
      color: var(--ink-2);
      cursor:pointer

      transition: all 180ms ease;
    }

    .menu-toggle[aria-expanded="true"] {
      background: var(--bg-raised);
    }

    .menu-close-icon {
      display: none;
    }

    .menu-toggle[aria-expanded="true"] .menu-open-icon {
      display: none;
    }

    .menu-toggle[aria-expanded="true"] .menu-close-icon {
      display: block;
    }

    nav .menu-list {
      display: grid;
    }
  }

  @keyframes user-button-fallback-shimmer {
    0% {
      background-position: 200% 0;
    }

    100% {
      background-position: -200% 0;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>(".header-nav");

  function openMenu() {
    menu?.classList.add("is-open");
    button?.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    menu?.classList.remove("is-open");
    button?.setAttribute("aria-expanded", "false");
  }

  button?.addEventListener("click", () => {
    if (button.getAttribute("aria-expanded") === "true") {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) {
      closeMenu();
    }
  });
</script>
